                  "endLine": 57
                }
              }
            }
          ],
          "properties": {
            "confidence": "confirmed",
            "severity": "medium"
          }
        },
        {
          "ruleId": "S002",
          "ruleIndex": 1,
          "level": "note",
          "message": {
            "text": "MDS072 caps probe concurrency but not the total number of outbound requests per run, so a hostile document is an egress/DoS amplifier"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "internal/rules/externallink/rule.go"
                },
                "region": {
                  "startLine": 300,
                  "endLine": 334
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "internal/rules/externallink/rule.go"
                },
                "region": {
                  "startLine": 135,
                  "endLine": 168
                }
              }
            }
          ],
          "properties": {
            "confidence": "confirmed",
            "severity": "low"
          }
        },
        {
          "ruleId": "S003",
          "ruleIndex": 2,
          "level": "note",
          "message": {
            "text": "Telemetry / network-policy docs still assert zero runtime egress and do not disclose the opt-in MDS072 network access"
          },
          "locations": [
            {
              "physicalLocation": {
